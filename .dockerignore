.git
.gitignore

# Local environment and secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*

# Python caches and test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Node/package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local/editor files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Runtime logs
*.log
logs/
