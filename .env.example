# Medical AI Triage environment template
#
# Docker Compose reads the root `.env` file by default. Copy this file to `.env`
# at the repository root and fill in the secret values locally.

# Backend runtime
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
CLASSIFY_TIMEOUT_SECONDS=8

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Auth
# Keep enabled outside local smoke tests. Set false only for controlled dev runs.
AUTH_ENABLED=true

# CORS
# Pydantic settings expects JSON for list values from environment variables.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
